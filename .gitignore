# Default-deny policy: only reusable tools, source, and documentation are allowlisted below.
/*

# Root-level reusable documentation
!/.gitignore
!/README.md
!/AGENTS.md
!/AutoResearch出题全流程指引.md
!/部署与长程接管.md
!/双Agent长跑与题目包验收规范.md

# Allowed top-level collections; their contents remain deny-by-default.
!/materials/
!/notes/
!/ops/
!/tools/

# Reusable materials and QA skill documentation/scripts
/materials/*
!/materials/README.md
!/materials/AutoResearch 专家线下标注教程/
/materials/AutoResearch 专家线下标注教程/*
!/materials/AutoResearch 专家线下标注教程/*.md
!/materials/AutoResearch 项目培训/
/materials/AutoResearch 项目培训/*
!/materials/AutoResearch 项目培训/*.md
!/materials/规范格式/
/materials/规范格式/*
!/materials/规范格式/*.md
!/materials/autoresearch-qa-skills/
!/materials/autoresearch-qa-skills/autoresearch-baseline-quality/
/materials/autoresearch-qa-skills/autoresearch-baseline-quality/*
!/materials/autoresearch-qa-skills/autoresearch-baseline-quality/SKILL.md
!/materials/autoresearch-qa-skills/autoresearch-baseline-quality/agents/
/materials/autoresearch-qa-skills/autoresearch-baseline-quality/agents/*
!/materials/autoresearch-qa-skills/autoresearch-baseline-quality/agents/*.yaml
!/materials/autoresearch-qa-skills/autoresearch-baseline-quality/references/
/materials/autoresearch-qa-skills/autoresearch-baseline-quality/references/*
!/materials/autoresearch-qa-skills/autoresearch-baseline-quality/references/*.md
!/materials/autoresearch-qa-skills/autoresearch-task-qa/
/materials/autoresearch-qa-skills/autoresearch-task-qa/*
!/materials/autoresearch-qa-skills/autoresearch-task-qa/SKILL.md
!/materials/autoresearch-qa-skills/autoresearch-task-qa/agents/
/materials/autoresearch-qa-skills/autoresearch-task-qa/agents/*
!/materials/autoresearch-qa-skills/autoresearch-task-qa/agents/*.yaml
!/materials/autoresearch-qa-skills/autoresearch-task-qa/references/
/materials/autoresearch-qa-skills/autoresearch-task-qa/references/*
!/materials/autoresearch-qa-skills/autoresearch-task-qa/references/*.md
!/materials/autoresearch-qa-skills/autoresearch-task-qa/scripts/
/materials/autoresearch-qa-skills/autoresearch-task-qa/scripts/*
!/materials/autoresearch-qa-skills/autoresearch-task-qa/scripts/*.py

# Reusable operational notes only; future task/evidence directories stay ignored.
/notes/*
!/notes/*.md
!/notes/gpu-scheduler-v1/
/notes/gpu-scheduler-v1/*
!/notes/gpu-scheduler-v1/*.md
!/notes/gpu-scheduler-v2-blocking/
/notes/gpu-scheduler-v2-blocking/*
!/notes/gpu-scheduler-v2-blocking/*.md

# Explicitly allow the generic operations helper only.
/ops/*
!/ops/transfer_remote.py

# Generic GPU monitor source, README, and example configuration.
/tools/*
!/tools/README.md
!/tools/research_completion/
!/tools/research_completion/*.py
!/tools/gpu_monitor/
/tools/gpu_monitor/*
!/tools/gpu_monitor/.gitignore
!/tools/gpu_monitor/README.md
!/tools/gpu_monitor/*.py
!/tools/gpu_monitor/examples/
/tools/gpu_monitor/examples/*
!/tools/gpu_monitor/examples/*.json

# Generic GPU scheduler source, README, and example configuration.
!/tools/gpu_scheduler/
/tools/gpu_scheduler/*
!/tools/gpu_scheduler/*.py
!/tools/gpu_scheduler/*.md
!/tools/gpu_scheduler/*.json

# Generic long-run handoff source, templates, README, and provenance.
!/tools/research_handoff/
/tools/research_handoff/*
!/tools/research_handoff/*.py
!/tools/research_handoff/*.md
!/tools/research_handoff/*.json
!/tools/research_handoff/core/
/tools/research_handoff/core/*
!/tools/research_handoff/core/*.py
!/tools/research_handoff/providers/
/tools/research_handoff/providers/*
!/tools/research_handoff/providers/*.py
!/tools/research_handoff/templates/
/tools/research_handoff/templates/*
!/tools/research_handoff/templates/*.py
!/tools/research_handoff/templates/*.json
!/tools/research_handoff/templates/*.sh
!/tools/research_handoff/templates/public_docker_network.service.in
!/tools/research_handoff/templates/public_docker_network.timer.in

# Never allow generated files, tests, or credentials through the allowlist.
**/__pycache__/
**/*.py[cod]
**/tests/
**/test_*.py
**/*_test.py
**/.env
**/.env.*
**/api_key.txt
**/auth.txt
**/*.pem
**/*.key
**/*.secret
